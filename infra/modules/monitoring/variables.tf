variable "name" {
  description = "Prefix of the topic and the alarms, normally <project>-<env>."
  type        = string
}

variable "alert_emails" {
  description = "E-mail addresses subscribed to the topic. Each one must confirm the subscription."
  type        = list(string)

  validation {
    condition     = length(var.alert_emails) > 0
    error_message = "Provide at least one e-mail address."
  }
}

variable "alb_arn_suffix" {
  description = "ARN suffix of the load balancer."
  type        = string
}

variable "target_group_arn_suffix" {
  description = "ARN suffix of the target group."
  type        = string
}

variable "cluster_name" {
  description = "Name of the ECS cluster."
  type        = string
}

variable "service_name" {
  description = "Name of the ECS service."
  type        = string
}

variable "desired_count" {
  description = "Tasks the service should run; RunningTaskCount below this raises the alarm."
  type        = number
}

variable "db_instance_identifier" {
  description = "Identifier of the RDS instance."
  type        = string
}

variable "period_seconds" {
  description = "Length of each evaluation period."
  type        = number
  default     = 60
}

variable "evaluation_periods" {
  description = "Consecutive periods that must breach before an alarm fires."
  type        = number
  default     = 2
}

variable "cpu_threshold_percent" {
  description = "CPU utilization (ECS service and RDS) that raises an alarm."
  type        = number
  default     = 80
}

variable "memory_threshold_percent" {
  description = "ECS service memory utilization that raises an alarm."
  type        = number
  default     = 80
}

variable "target_5xx_threshold" {
  description = "5xx responses from the app in one period that raise an alarm."
  type        = number
  default     = 5
}

variable "elb_5xx_threshold" {
  description = "5xx responses generated by the load balancer in one period that raise an alarm."
  type        = number
  default     = 5
}

variable "response_time_p95_seconds" {
  description = "p95 target response time that raises an alarm."
  type        = number
  default     = 1
}

variable "db_free_storage_bytes" {
  description = "RDS free storage below this raises an alarm."
  type        = number
  default     = 2147483648
}

variable "db_freeable_memory_bytes" {
  description = "RDS freeable memory below this raises an alarm."
  type        = number
  default     = 67108864
}

variable "tags" {
  description = "Extra tags merged into every resource (on top of the provider default tags)."
  type        = map(string)
  default     = {}
}
