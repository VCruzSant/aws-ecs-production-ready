variable "name" {
  description = "Identifier of the DB instance and subnet group, and prefix of the security group and parameter group."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,47}$", var.name)) && !endswith(var.name, "-") && !strcontains(var.name, "--")
    error_message = "name must start with a lowercase letter and have up to 48 lowercase letters, digits or single hyphens, not ending in a hyphen."
  }
}

variable "vpc_id" {
  description = "ID of the VPC."
  type        = string
}

variable "private_subnet_ids" {
  description = "Private subnets for the DB subnet group, in at least two AZs."
  type        = list(string)

  validation {
    condition     = length(var.private_subnet_ids) >= 2
    error_message = "RDS needs subnets in at least two AZs."
  }
}

variable "app_security_group_id" {
  description = "Security group of the app tasks, the only allowed source of connections."
  type        = string
}

variable "engine_version" {
  description = "Postgres version; a major only (\"16\") lets RDS pick and upgrade the minor."
  type        = string
  default     = "16"
}

variable "instance_class" {
  description = "DB instance class."
  type        = string
  default     = "db.t4g.micro"
}

variable "allocated_storage" {
  description = "Storage in GiB (gp3)."
  type        = number
  default     = 20
}

variable "db_name" {
  description = "Name of the database created with the instance."
  type        = string
  default     = "demo"
}

variable "username" {
  description = "Master username; the password is generated by RDS."
  type        = string
  default     = "demo"
}

variable "port" {
  description = "Port Postgres listens on."
  type        = number
  default     = 5432
}

variable "multi_az" {
  description = "Keep a standby in a second AZ (doubles the instance cost)."
  type        = bool
  default     = false
}

variable "backup_retention_period" {
  description = "Days of automated backups (0 disables them)."
  type        = number
  default     = 0
}

variable "skip_final_snapshot" {
  description = "Delete the instance without a final snapshot."
  type        = bool
  default     = true
}

variable "deletion_protection" {
  description = "Block deletion of the instance."
  type        = bool
  default     = false
}

variable "apply_immediately" {
  description = "Apply changes now instead of in the next maintenance window."
  type        = bool
  default     = true
}

variable "tags" {
  description = "Extra tags merged into every resource (on top of the provider default tags)."
  type        = map(string)
  default     = {}
}
