# Copy to terraform.tfvars (git-ignored) to override the defaults.
# region             = "us-east-2"
# vpc_cidr           = "10.0.0.0/16"
# az_count           = 2
# enable_nat_gateway = true
# single_nat_gateway = true  # false = one NAT Gateway per AZ (HA, ~2x the NAT cost)
# image_tag          = "abc1234"  # usually passed by make (IMAGE_TAG), not set here
# task_cpu           = 256
# task_memory        = 512
# desired_count      = 1
# container_insights = false
# db_instance_class  = "db.t4g.micro"
# db_multi_az        = false  # true = standby in a second AZ (~2x the database cost)
# enable_flow_logs   = true
# alb_access_logs    = true
