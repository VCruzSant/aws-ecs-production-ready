# Copy to .env (never commit .env).
# DB_HOST is overridden to "db" inside docker compose; `make test` uses "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=demo
DB_USER=demo
DB_PASSWORD=change-me-local-only
# The local Postgres has no TLS; AWS uses "verify-full" with DB_SSLROOTCERT.
DB_SSLMODE=prefer
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=change-me-local-only
GRAFANA_AWS_REGION=us-east-2
